<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<meta name="color-scheme" content="light dark">
<title>News Digest &mdash; {{ digest.date.isoformat() }}</title>
<link rel="stylesheet" href="../styles.css">
</head>
<body>
<header>
  <h1>Daily News Digest</h1>
  <p class="date">{{ digest.date.strftime('%A, %d %B %Y') }}</p>
  <nav><a href="../index.html">&larr; Archive</a></nav>
</header>

{% if episode %}
<section class="podcast-player">
  <h2 class="podcast-label">&#127911; Listen to today's episode</h2>
  <audio controls preload="none" src="../{{ episode.mp3_path }}">
    Your browser doesn't support inline audio. <a href="../{{ episode.mp3_path }}">Download the episode</a> instead.
  </audio>
  <p class="podcast-subscribe"><a href="../feed.xml">Subscribe to the podcast</a></p>
</section>
{% endif %}

{% for group in digest.groups %}
<section class="group group-{{ group.group.value }}">
  <h2>{{ group.group | group_label }}</h2>
  {% if group.overview_de %}
  <p class="overview">{{ group.overview_de }}</p>
  {% endif %}

  {% if group.items %}
  <div class="cards">
    {% for item in group.items %}
    <article class="card">
      <h3><a href="{{ item.cluster.lead.url }}">{{ item.cluster.lead.title }}</a></h3>
      <p class="meta">
        <span class="source">{{ item.cluster.lead.source }}</span>
        <span class="lang">{{ item.cluster.lead.language }}</span>
        {% if item.summary and item.summary.law %}
        <span class="badge">{{ item.summary.law.jurisdiction }} &middot; {{ item.summary.law.status.value }}{% if item.summary.law.effective_date %} &middot; from {{ item.summary.law.effective_date.isoformat() }}{% endif %}</span>
        {% endif %}
      </p>
      {% if item.summary %}
      <p class="summary">{{ item.summary.text }}</p>
      <p class="why-it-matters"><strong>Why it matters:</strong> {{ item.summary.why_it_matters }}</p>
      {% else %}
      <p class="summary teaser-fallback">{{ item.cluster.lead.teaser }}</p>
      {% endif %}
      {% if item.cluster.also_covered_by %}
      <p class="also-covered">Also covered by:
        {% for other in item.cluster.also_covered_by %}
        <a href="{{ other.url }}">{{ other.source }}</a>{% if not loop.last %},{% endif %}
        {% endfor %}
      </p>
      {% endif %}
    </article>
    {% endfor %}
  </div>
  {% else %}
  <p class="empty">No stories today.</p>
  {% endif %}

  {% if group.also_considered %}
  <details class="also-considered">
    <summary>
      Also considered
      {% if group.also_considered_total > group.also_considered | length %}
      (top {{ group.also_considered | length }} of {{ group.also_considered_total }})
      {% else %}
      ({{ group.also_considered | length }})
      {% endif %}
    </summary>
    <ul>
      {% for sc in group.also_considered %}
      <li>
        <a href="{{ sc.cluster.lead.url }}">{{ sc.cluster.lead.title }}</a>
        &mdash; score {{ "%.1f"|format(sc.final_score) }}: {{ sc.reason }}
      </li>
      {% endfor %}
    </ul>
  </details>
  {% endif %}
</section>
{% endfor %}

<footer>
  <p>Generated by news-digest.</p>
</footer>
</body>
</html>
