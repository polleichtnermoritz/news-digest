<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:itunes="http://www.itunes.com/dtds/podcast-1.0.dtd" xmlns:atom="http://www.w3.org/2005/Atom">
<channel>
  <title>News Digest</title>
  <link>{{ settings.site_base_url }}/</link>
  <atom:link href="{{ settings.site_base_url }}/feed.xml" rel="self" type="application/rss+xml"/>
  <description>A short daily audio digest of tech, geopolitics and AI-paper news.</description>
  <language>en-us</language>
  <itunes:explicit>false</itunes:explicit>
  <itunes:category text="News"/>
{% for episode in episodes %}
  <item>
    <title>{{ episode.title }}</title>
    <description>{{ episode.title }}</description>
    <pubDate>{{ episode.date.strftime('%a, %d %b %Y 07:00:00 +0000') }}</pubDate>
    <guid isPermaLink="false">news-digest-{{ episode.date.isoformat() }}</guid>
    <enclosure url="{{ settings.site_base_url }}/{{ episode.mp3_path }}" type="audio/mpeg" length="{{ episode.mp3_bytes }}"/>
  </item>
{% endfor %}
</channel>
</rss>
