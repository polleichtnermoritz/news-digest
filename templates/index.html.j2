<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<meta name="color-scheme" content="light dark">
<title>News Digest &mdash; Archive</title>
<link rel="stylesheet" href="styles.css">
</head>
<body>
<header>
  <h1>Daily News Digest</h1>
  <p class="date">Latest: <a href="digest/{{ latest_date }}.html">{{ latest_date }}</a></p>
  {% if podcast_enabled %}
  <p class="podcast-subscribe">&#127911; <a href="feed.xml">Subscribe to the podcast</a></p>
  {% endif %}
</header>

<h2>Archive</h2>
<ul class="archive">
  {% for d in archive_dates %}
  <li><a href="digest/{{ d }}.html">{{ d }}</a></li>
  {% endfor %}
</ul>

<footer>
  <p>Generated by news-digest.</p>
</footer>
</body>
</html>
